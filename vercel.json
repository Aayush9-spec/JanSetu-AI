{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/requests", "destination": "/index.html" },
    { "source": "/hotspots", "destination": "/index.html" },
    { "source": "/gaps", "destination": "/index.html" },
    { "source": "/infrastructure", "destination": "/index.html" },
    { "source": "/data", "destination": "/index.html" },
    { "source": "/recommendations", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/impact", "destination": "/index.html" },
    { "source": "/explorer", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ]
}
